# Copy this file to .env.local and fill in the values. Never commit .env.local.
# These variables are read on the server only; they are never sent to the browser.

# Which AI backend to use:
#   auto   - use Gemini when GEMINI_API_KEY is set, otherwise the built-in mock (default)
#   gemini - always try Gemini (falls back to the mock if it fails, see AI_FALLBACK_TO_MOCK)
#   mock   - never call an external API
AI_PROVIDER=auto

# Get a key at https://aistudio.google.com/apikey
# Free-tier keys have small daily request limits per model; when they run out the app falls back to the mock.
GEMINI_API_KEY=

# Model name. Model names change over time: check the Gemini API documentation.
GEMINI_MODEL=gemini-3.5-flash

# Timeout of one model call in milliseconds (1000-55000).
AI_TIMEOUT_MS=45000

# Total attempts for temporary failures such as 503 or malformed output (1-4).
AI_MAX_ATTEMPTS=3

# If Gemini fails, answer with the mock provider and flag it in the UI (true) or return an error (false).
AI_FALLBACK_TO_MOCK=true
